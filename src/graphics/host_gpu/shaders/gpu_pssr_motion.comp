#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

// Motion vectors in render pixels to the previous frame: the guest's vectors times their scale plus
// their offset, for upscalers that take a scale only.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D source;
layout(binding = 1, rg16f) writeonly uniform image2D destination;
layout(push_constant) uniform Parameters {
	uvec2 base;
	uvec2 size;
	vec2  scale;
	vec2  offset;
} parameters;

void main() {
	uvec2 coordinate = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(coordinate, parameters.size))) return;
	ivec2 texel = ivec2(parameters.base + coordinate);
	vec2  motion = texelFetch(source, texel, 0).xy * parameters.scale + parameters.offset;
	imageStore(destination, texel, vec4(motion, 0.0, 0.0));
}
