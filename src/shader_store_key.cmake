# The shader store key: a hash of the sources that produce stored records (programs, modules and
# their SPIR-V, pipelines) and of the build flags, so that a rebuild that leaves them alone keeps
# the store. Hashing too much only costs a cold launch; missing a producer would load stale SPIR-V,
# so whole directories are hashed and new files in them count by default.
#
# Included by CMakeLists.txt for the file list; run with -P at build time to write the key:
#   -DROOT=<source root> -DBUILD_FILE=<build flags file> -DOUTPUT=<header>

# Hashed with their subdirectories.
set(KYTY_SHADER_STORE_KEY_DIRS
	# Recompiler, IR passes and resource tracking, SPIR-V emitter, static keys, pretranslation.
	src/graphics/shader
	# Program cache, module and pipeline records, the store format.
	src/graphics/host_gpu/renderer/pipeline
	# The SPIR-V enums the emitter writes.
	3rdparty/SPIRV-Headers/include
)
# Hashed as they are, without subdirectories.
set(KYTY_SHADER_STORE_KEY_FILES
	# Register, format and tiling definitions the recompiler reads.
	src/graphics/guest_gpu/*.h
	src/graphics/guest_gpu/gpu_format.cpp
	# Host features and their defaults.
	src/graphics/host_gpu/graphicContext.h
	# Buffer cache page constants baked into the SPIR-V.
	src/graphics/host_gpu/renderer/cache/bufferCache.h
	src/shader_store_key.cmake
)
# Draw-time code of the hashed directories: it binds and creates from records but writes none.
set(KYTY_SHADER_STORE_KEY_EXCLUDE
	src/graphics/host_gpu/renderer/pipeline/asyncPipelinePolicy.h
	src/graphics/host_gpu/renderer/pipeline/blendMapping.cpp
	src/graphics/host_gpu/renderer/pipeline/descriptorHeap.cpp
	src/graphics/host_gpu/renderer/pipeline/descriptors.cpp
	src/graphics/host_gpu/renderer/pipeline/imageHeap.cpp
	src/graphics/host_gpu/renderer/pipeline/shaderResourceBarrier.cpp
)

# The hashed files under `root`, relative and sorted.
function(kyty_shader_store_key_files root out)
	set(depends)
	if(NOT CMAKE_SCRIPT_MODE_FILE)
		set(depends CONFIGURE_DEPENDS)
	endif()
	set(dirs)
	foreach(dir IN LISTS KYTY_SHADER_STORE_KEY_DIRS)
		list(APPEND dirs "${root}/${dir}/*")
	endforeach()
	set(files)
	foreach(pattern IN LISTS KYTY_SHADER_STORE_KEY_FILES)
		list(APPEND files "${root}/${pattern}")
	endforeach()
	file(GLOB_RECURSE in_dirs LIST_DIRECTORIES false RELATIVE "${root}" ${depends} ${dirs})
	file(GLOB in_files LIST_DIRECTORIES false RELATIVE "${root}" ${depends} ${files})
	set(result ${in_dirs} ${in_files})
	list(REMOVE_ITEM result ${KYTY_SHADER_STORE_KEY_EXCLUDE})
	list(REMOVE_DUPLICATES result)
	list(SORT result)
	set(${out} ${result} PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
	if(NOT DEFINED ROOT OR NOT DEFINED BUILD_FILE OR NOT DEFINED OUTPUT)
		message(FATAL_ERROR "shader_store_key.cmake requires ROOT, BUILD_FILE and OUTPUT")
	endif()
	kyty_shader_store_key_files("${ROOT}" sources)
	if(NOT sources)
		message(FATAL_ERROR "shader_store_key.cmake: no source under ${ROOT}")
	endif()
	# Paths count too, so that a move changes the key.
	set(manifest "")
	foreach(source IN LISTS sources)
		file(SHA256 "${ROOT}/${source}" hash)
		string(APPEND manifest "${source} ${hash}\n")
	endforeach()
	file(READ "${BUILD_FILE}" build)
	string(APPEND manifest "build\n${build}")
	string(SHA256 key "${manifest}")
	list(LENGTH sources count)
	file(WRITE "${OUTPUT}"
		"// Generated by shader_store_key.cmake from ${count} files and the build flags.\n"
		"#pragma once\n"
		"#define KYTY_SHADER_STORE_SOURCE_KEY \"${key}\"\n")
endif()
