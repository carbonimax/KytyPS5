# The shader store key changes with a hashed source, a new or moved hashed file and the build flags,
# and only with them. -DSCRIPT=<shader_store_key.cmake> -DWORK=<scratch directory>
file(REMOVE_RECURSE "${WORK}")
set(root "${WORK}/root")
set(build "${WORK}/build.txt")

function(put path text)
	file(WRITE "${root}/${path}" "${text}")
endfunction()

function(key out)
	execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${root}" "-DBUILD_FILE=${build}"
	                        "-DOUTPUT=${WORK}/key.h" -P "${SCRIPT}" RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "shader_store_key.cmake failed: ${result}")
	endif()
	file(STRINGS "${WORK}/key.h" line REGEX "KYTY_SHADER_STORE_SOURCE_KEY")
	set(${out} "${line}" PARENT_SCOPE)
endfunction()

set(last "")
function(expect name changed)
	key(now)
	if(changed AND now STREQUAL last)
		message(FATAL_ERROR "${name}: the key did not change")
	elseif(NOT changed AND NOT now STREQUAL last)
		message(FATAL_ERROR "${name}: the key changed")
	endif()
	set(last "${now}" PARENT_SCOPE)
endfunction()

put(src/graphics/shader/recompiler/ir/a.cpp "a")
put(src/graphics/host_gpu/renderer/pipeline/shaderStore.cpp "store")
put(src/graphics/host_gpu/renderer/pipeline/descriptors.cpp "bind")
put(src/graphics/guest_gpu/gpu_format.h "format")
put(src/graphics/guest_gpu/command_processor/pm4Handlers.cpp "packets")
put(src/kernel/memory.cpp "kernel")
file(WRITE "${build}" "Clang 22 Release -O2")

expect("first" TRUE)
expect("same tree" FALSE)
file(TOUCH "${root}/src/graphics/shader/recompiler/ir/a.cpp")
expect("touched only" FALSE)
put(src/kernel/memory.cpp "kernel 2")
expect("unhashed file" FALSE)
put(src/graphics/host_gpu/renderer/pipeline/descriptors.cpp "bind 2")
expect("draw-time file" FALSE)
put(src/graphics/guest_gpu/command_processor/pm4Handlers.cpp "packets 2")
expect("guest_gpu subdirectory" FALSE)
put(src/graphics/shader/recompiler/ir/a.cpp "a 2")
expect("recompiler source" TRUE)
put(src/graphics/host_gpu/renderer/pipeline/shaderStore.cpp "store 2")
expect("store source" TRUE)
put(src/graphics/guest_gpu/gpu_format.h "format 2")
expect("guest_gpu header" TRUE)
put(src/graphics/shader/recompiler/ir/b.cpp "b")
expect("new file" TRUE)
file(RENAME "${root}/src/graphics/shader/recompiler/ir/b.cpp" "${root}/src/graphics/shader/recompiler/ir/c.cpp")
expect("moved file" TRUE)
file(WRITE "${build}" "Clang 22 Release -O2 -march=x86-64-v3")
expect("build flags" TRUE)
message(STATUS "shader store key: ok")
